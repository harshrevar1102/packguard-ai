# PackGuard AI Configuration
# Safe defaults: If AI keys are not provided, deterministic comparison runs automatically.

# AI Provider: 'auto', 'openai', 'gemini', 'anthropic', or 'none'
AI_PROVIDER=auto

# Optional API Keys for AI Semantic Analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Storage Directory
DATA_DIR=./data

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
